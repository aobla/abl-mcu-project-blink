{
    "version": 3,
    "configurePresets": [
        {
            "name": "blink-stm32f103",
            "displayName": "blink / STM32F103 (Blue Pill)",
            "description": "Dev-удобство для IDE. Основной вход — ./build.sh (он сам читает YAML). Пресет предполагает sibling-репозиторий платформы.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/preset-stm32f103",
            "cacheVariables": {
                "PLATFORM": "stm32f103",
                "MCU_PART": "STM32F103C6T6",
                "ABL_RUNTIME": "bare",
                "CMAKE_BUILD_TYPE": "Debug",
                "PROJECT_NAME": "blink-led-stm32f103",
                "OUTPUT_NAME": "blink-led-stm32f103",
                "APP_CONFIG": "${sourceDir}/config/blink_stm32f103.yml",
                "BOARD_FILE": "${sourceDir}/../abl-mcu-platform/boards/bluepill_stm32f103.yml"
            }
        },
        {
            "name": "blink-stm32h743",
            "displayName": "blink / STM32H743 (DEVEBOX)",
            "description": "Dev-удобство для IDE (см. blink-stm32f103).",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/preset-stm32h743",
            "cacheVariables": {
                "PLATFORM": "stm32h743",
                "MCU_PART": "STM32H743VIT6",
                "ABL_RUNTIME": "bare",
                "CMAKE_BUILD_TYPE": "Debug",
                "PROJECT_NAME": "blink-led-stm32h743",
                "OUTPUT_NAME": "blink-led-stm32h743",
                "APP_CONFIG": "${sourceDir}/config/blink_stm32h743.yml",
                "BOARD_FILE": "${sourceDir}/../abl-mcu-platform/boards/devebox_stm32h743.yml"
            }
        },
        {
            "name": "blink-avr",
            "displayName": "blink / ATmega328P",
            "description": "Dev-удобство для IDE (см. blink-stm32f103).",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/preset-avr",
            "cacheVariables": {
                "PLATFORM": "avr",
                "AVR_MCU": "atmega328p",
                "F_CPU_HZ": "16000000",
                "ABL_RUNTIME": "bare",
                "CMAKE_BUILD_TYPE": "Debug",
                "PROJECT_NAME": "blink-led-atmega328p",
                "OUTPUT_NAME": "blink-led-atmega328p",
                "APP_CONFIG": "${sourceDir}/config/blink_atmega328p.yml",
                "BOARD_FILE": "${sourceDir}/../abl-mcu-platform/boards/atmega328p_generic.yml"
            }
        }
    ],
    "buildPresets": [
        { "name": "blink-stm32f103-build", "configurePreset": "blink-stm32f103" },
        { "name": "blink-stm32h743-build", "configurePreset": "blink-stm32h743" },
        { "name": "blink-avr-build", "configurePreset": "blink-avr" }
    ]
}
